# Copy to .env for local use. The server loads .env automatically; real environment
# variables (for example on your hosting platform) take priority. Never commit .env.

# development (default), production or test
NODE_ENV=development
PORT=3000

# Comma-separated exact origins allowed to call the API from a browser,
# for example https://app.example.com,http://localhost:5173
# Empty: development allows any localhost origin; production allows no browser origins.
# "*" is rejected in production.
CORS_ORIGIN=

# Rate limit for /api routes, per client IP: RATE_LIMIT_MAX requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Reverse-proxy hops to trust so rate limits see the real client IP (0 = none).
# Set 1 behind one proxy such as Render, Railway or Nginx.
# Not setting this in production logs a startup warning. Render: 1 (see render.yaml).
TRUST_PROXY=0

# true (default outside tests) or false: one JSON log line per request.
LOG_REQUESTS=true
# Max time to finish in-flight requests on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000
