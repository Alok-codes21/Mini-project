                  "fromBase",
                  "toBase"
                ],
                "properties": {
                  "number": {
                    "type": "string",
                    "maxLength": 65,
                    "example": "13"
                  },
                  "fromBase": {
                    "enum": [
                      2,
                      8,
                      10,
                      16
                    ]
                  },
                  "toBase": {
                    "enum": [
                      2,
                      8,
                      10,
                      16
                    ]
