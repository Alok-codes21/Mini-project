    "/api/number-system/convert": {
      "post": {
        "summary": "Convert a signed integer between bases 2, 8, 10 and 16",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "number",
                  "fromBase",
                  "toBase"
                ],
                "properties": {
                  "number": {
                    "type": "string",
                    "maxLength": 65,
                    "example": "13"
                  },
                  "fromBase": {
                    "enum": [
                      2,
                      8,
                      10,
                      16
                    ]
                  },
                  "toBase": {
                    "enum": [
                      2,
                      8,
                      10,
                      16
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result with step-by-step trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
