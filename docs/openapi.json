    "/api/practice/check": {
      "post": {
        "summary": "Check a learner's answer",
        "description": "Recalculates the operation from input and compares it with answer. If the answer is wrong, firstWrongStep points at the step in the full trace (call the matching operation endpoint to see it) where the learner most likely went wrong. The reason and confidence fields say how sure that guess is. Matrix answers are compared cell by cell in calculation order; numbers within a relative 1e-9 count as equal. Conversion answers are case-insensitive and ignore leading zeros.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operation",
                  "input",
                  "answer"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "add",
                      "subtract",
                      "transpose",
                      "multiply",
                      "determinant",
                      "convert"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "description": "Same body as the matching operation endpoint: { A, B } for matrices, { number, fromBase, toBase } for convert."
                  },
                  "answer": {
                    "description": "A matrix (array of rows) for add, subtract, transpose and multiply; a number for determinant; a string for convert."
                  },
                  "reveal": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, the response also includes the correct answer as expected."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "schemaVersion",
                    "module",
                    "operation",
                    "correct",
                    "totalSteps"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "schemaVersion": {
                      "type": "string"
                    },
                    "module": {
                      "type": "string",
                      "enum": [
                        "matrix",
                        "number-system"
                      ]
                    },
                    "operation": {
                      "type": "string"
                    },
                    "correct": {
                      "type": "boolean"
                    },
                    "totalSteps": {
                      "type": "integer",
                      "description": "Number of steps in the full trace."
                    },
                    "expected": {
                      "description": "Only when reveal is true."
                    },
                    "firstWrongStep": {
                      "type": "object",
                      "description": "Only when correct is false.",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "stage": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "explanation": {
                          "type": "string"
                        },
                        "highlights": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "reason": {
                          "type": "string",
                          "enum": [
                            "shape",
                            "cell-mismatch",
                            "stopped-early",
                            "sign",
                            "term-skipped",
                            "invalid-digit",
                            "sign-mismatch",
                            "reversed",
                            "remainder-mismatch",
                            "extra-digits",
                            "digit-mismatch",
                            "unknown"
                          ]
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "high",
                            "medium",
                            "low"
                          ]
                        },
                        "hint": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Use POST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body over 64 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type or encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Step": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "action",
          "title",
          "explanation",
          "formula",
          "keyPoints",
          "state",
          "highlights"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "stage": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The last entry is a 'Why: ...' line that says why the step is done."
          },
          "state": {
            "type": "object"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "displayFormula": {
            "type": "string",
            "description": "Optional. The formula with 1-based indices (A[1][2]) to match the explanation text. Present only when it differs from formula. formula, state and highlights always use 0-based indices."
          }
        }
      },
      "Response": {
        "type": "object",
        "required": [
          "success",
          "schemaVersion",
          "module",
          "operation",
          "level",
          "input",
          "result",
          "steps",
          "summary"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "schemaVersion": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "result": {},
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          },
          "summary": {
            "type": "object",
