  "components": {
    "schemas": {
      "Step": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "action",
          "title",
          "explanation",
          "formula",
          "keyPoints",
          "state",
          "highlights"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "stage": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "object"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Response": {
        "type": "object",
        "required": [
          "success",
          "schemaVersion",
          "module",
          "operation",
          "level",
          "input",
          "result",
          "steps",
          "summary"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "schemaVersion": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "result": {},
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "totalSteps": {
                "type": "integer"
              },
              "keyPoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
