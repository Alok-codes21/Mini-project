{
  "openapi": "3.0.3",
  "info": {
    "title": "Matrix & Number System Learning API",
    "version": "1.2.0",
    "description": "Returns each answer plus a step-by-step trace for frontend visualization. Computed decimals are rounded to 15 significant digits to remove floating-point noise (0.1 + 0.2 is returned as 0.3). When rounding changes a value, the response includes summary.notes. Responses are gzip-compressed when the client sends Accept-Encoding: gzip."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api": {
      "get": {
        "summary": "Route and limit discovery",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/matrix/add": {
      "post": {
        "summary": "Add two matrices",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "A",
                  "B"
                ],
                "properties": {
                  "A": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    }
                  },
                  "B": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "number",
                        "minimum": -1000000,
                        "maximum": 1000000
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result with step-by-step trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body over 64 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type or encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Result too large to show exactly (error.field is A, B or \"result\"; computed values report \"result\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "detail",
            "in": "query",
            "required": false,
            "description": "How many steps to return. full (default) returns every step. compact returns one step per result cell (matrices), per digit read and per remainder (number conversion), and per cofactor term (determinants). beginner returns the full trace plus a leading before-you-start step. Unknown values return 400 INVALID_INPUT with field \"detail\".",
            "schema": {
              "type": "string",
              "enum": [
                "full",
                "compact",
                "beginner"
              ],
              "default": "full"
            }
          }
        ]
      }
    },
